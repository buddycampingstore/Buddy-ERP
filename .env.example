# Supabase configuration for local development and Vercel.
# These values are public in the browser, so use the Supabase anon key only.
# Database protection must come from Supabase Auth + RLS policies.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
